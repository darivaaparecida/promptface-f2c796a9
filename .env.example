# GEMINI_API_KEY: Required for Gemini AI image generation and prompt enhancement.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Stripe (Test/Live billing in BRL - Card + Pix Automático)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# Optional fallback image provider & transactional email
FAL_API_KEY=
RESEND_API_KEY=

# Optional server-side admin bootstrap passcode
ADMIN_PASSWORD=
